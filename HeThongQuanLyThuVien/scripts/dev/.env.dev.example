# Copy file này thành scripts/dev/.env.dev rồi điền thông tin thật.
# .env.dev đã nằm trong .gitignore — không commit mật khẩu.

# Địa chỉ API (mặc định http://localhost:5058)
QUANLYTHUVIEN_API_URL=http://localhost:5058

# Tài khoản Admin (dùng cho mọi lệnh mặc định)
ADMIN_USER=admin.dev
ADMIN_PASS=

# Tài khoản Thủ thư (chỉ cần khi chạy: AS=manager ./scripts/dev/staff.sh ...)
# Tạo bằng: ./scripts/dev/staff.sh new-staff "Trần Thị Thủ Thư" thuthu.test
MANAGER_USER=
MANAGER_PASS=
