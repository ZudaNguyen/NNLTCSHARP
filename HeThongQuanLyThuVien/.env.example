# Copy to .env and replace with a private SQL Server SA password.
# Never commit .env or share its value.
MSSQL_SA_PASSWORD=Replace_With_A_Strong_Local_Password_Only

# Tùy chọn cho scripts/dev/api.http (REST Client). Không cần để chạy ứng dụng.
# ADMIN_USER=admin.dev
# ADMIN_PASS=<mật khẩu admin>
# READER_USER=docgia.dev
# READER_PASS=<mật khẩu độc giả>
# NEW_READER_USER=docgia.api
# NEW_READER_PASS=<mật khẩu mạnh cho tài khoản đăng ký thử>
