@inject ReaderSession ReaderSession
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Thư Viện</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/QuanLyThuVien.Web.styles.css" asp-append-version="true" />
</head>
<body>
    @{
        var role = ViewData["Role"]?.ToString() ?? "reader";
        var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
        var action = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;
        var loanTab = Context.Request.Query["trangThai"].ToString();
        var isReader = role == "reader";
        var authenticated = isReader && ReaderSession.IsAuthenticated;

        string NavClass(bool active) => active ? "active" : string.Empty;
        var homeActive = controller == "Home" && action == "Index";
        var searchActive = controller == "Sach";
        var activeLoansActive = controller == "TaiKhoan" && action == "LichSuMuon" && loanTab == "dang-muon";
        var historyActive = controller == "TaiKhoan" && action == "LichSuMuon" && loanTab != "dang-muon";
        var profileActive = controller == "TaiKhoan" && action == "HoSo";

        var displayName = role switch
        {
            "admin" => "Nguyễn Minh An",
            "manager" => "Trần Thanh Hà",
            _ => authenticated ? ReaderSession.DisplayName : "Khách"
        };
        var roleName = role == "admin" ? "Quản trị viên" : role == "manager" ? "Thủ thư" : authenticated ? "Độc giả" : "Chưa đăng nhập";
        var initials = role == "admin" ? "MA" : role == "manager" ? "TH" : authenticated ? ReaderSession.Initials : "?";
        var noticeCount = ViewData["NotificationCount"] as int? ?? 0;
        var pendingRequestCount = ViewData["PendingRequestCount"] as int? ?? 0;
    }
    <div class="app-shell" data-role="@role">
        <aside class="sidebar" id="sidebar">
            <a class="brand" asp-controller="Home" asp-action="Index">
                <span class="brand-mark">▥</span><span>Thư Viện</span>
            </a>
            <nav class="side-nav" aria-label="Điều hướng chính">
                @if (isReader)
                {
                    <a class="@NavClass(homeActive)" asp-controller="Home" asp-action="Index"><span>⌂</span>Trang chủ</a>
                    <a class="@NavClass(searchActive && action == "Index")" asp-controller="Sach" asp-action="Index"><span>⌕</span>Tìm kiếm sách</a>
                    <a class="@NavClass(searchActive && action == "Details")" asp-controller="Sach" asp-action="Index" asp-fragment="the-loai"><span>▥</span>Danh mục sách</a>
                    <a class="@NavClass(activeLoansActive)" asp-controller="TaiKhoan" asp-action="LichSuMuon" asp-route-trangThai="dang-muon"><span>▤</span>Sách đang mượn</a>
                    <a class="@NavClass(controller == "YeuCauMuon")" asp-controller="YeuCauMuon" asp-action="Index">
                        <span>▣</span>Yêu cầu mượn
                        @if (pendingRequestCount > 0)
                        {
                            <b class="nav-badge">@pendingRequestCount</b>
                        }
                    </a>
                    <a class="@NavClass(historyActive)" asp-controller="TaiKhoan" asp-action="LichSuMuon"><span>◷</span>Lịch sử mượn trả</a>
                    <a class="@NavClass(profileActive)" asp-controller="TaiKhoan" asp-action="HoSo"><span>♙</span>Thông tin cá nhân</a>
                    <a asp-controller="Home" asp-action="Index" asp-fragment="notifications">
                        <span>♢</span>Thông báo
                        @if (noticeCount > 0)
                        {
                            <b class="nav-badge">@noticeCount</b>
                        }
                    </a>
                }
                else if (role == "manager")
                {
                    <a class="active" asp-action="Manager"><span>⌂</span>Tổng quan</a>
                    <a href="#inventory"><span>▥</span>Quản lý kho sách</a>
                    <a href="#circulation"><span>⇄</span>Mượn / Trả sách</a>
                    <a href="#reservation"><span>▣</span>Đặt trước sách</a>
                    <a href="#members"><span>♟</span>Quản lý thành viên</a>
                    <a href="#overdue"><span>♢</span>Nhắc nhở quá hạn <b class="nav-badge">3</b></a>
                    <a href="#report"><span>▥</span>Báo cáo nghiệp vụ</a>
                }
                else
                {
                    <a class="active" asp-action="Admin"><span>⌂</span>Tổng quan</a>
                    <a href="#users"><span>♟</span>Quản lý người dùng</a>
                    <a href="#roles"><span>◇</span>Phân quyền</a>
                    <a href="#books"><span>▥</span>Quản lý sách</a>
                    <a href="#categories"><span>▣</span>Danh mục</a>
                    <a href="#settings"><span>⚙</span>Cấu hình hệ thống</a>
                    <a href="#report"><span>▥</span>Báo cáo thống kê</a>
                }
            </nav>
            <div class="sidebar-user">
                <span class="avatar">@initials</span>
                <span><strong>@displayName</strong><small>@roleName</small></span>
                @if (authenticated)
                {
                    <form asp-controller="TaiKhoan" asp-action="Logout" method="post">
                        <button type="submit" title="Đăng xuất" aria-label="Đăng xuất">⏻</button>
                    </form>
                }
                else
                {
                    <button title="Cài đặt" aria-label="Cài đặt">⚙</button>
                }
            </div>
        </aside>
        <div class="app-main">
            <header class="topbar">
                <button class="menu-toggle" id="menuToggle" aria-label="Mở menu">☰</button>
                <form class="top-search" method="get" asp-controller="Sach" asp-action="Index" role="search">
                    <span>⌕</span>
                    <input id="topSearch" name="search" type="search" placeholder="Tìm sách, tác giả, ISBN..."
                           aria-label="Tìm kiếm sách" value="@Context.Request.Query["search"]" />
                </form>
                <div class="top-actions">
                    <a class="icon-button" asp-controller="Home" asp-action="Index" asp-fragment="notifications" aria-label="Thông báo" title="Thông báo">
                        ♢
                        @if (noticeCount > 0)
                        {
                            <i></i>
                        }
                    </a>
                    <span class="avatar small">@initials</span>
                    <strong>@roleName</strong>
                    @if (authenticated)
                    {
                        <form asp-controller="TaiKhoan" asp-action="Logout" method="post">
                            <button type="submit" class="top-logout">Đăng xuất</button>
                        </form>
                    }
                    else if (isReader)
                    {
                        <a class="top-login" asp-controller="TaiKhoan" asp-action="Login">Đăng nhập</a>
                        <a class="top-register" asp-controller="TaiKhoan" asp-action="Register">Đăng ký</a>
                    }
                    <span class="chevron">⌄</span>
                </div>
            </header>
            <main role="main" class="page-content">
                @RenderBody()
            </main>
        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
