@model HomeViewModel
@{
    ViewData["Title"] = "Trang chủ độc giả";
    ViewData["Role"] = "reader";

    string[] covers =
    [
        "cover-dune", "cover-atomic", "cover-dacnhantam", "cover-alchemist", "cover-cosmos",
        "cover-sapiens", "cover-thinking", "cover-clean", "cover-change", "cover-mindful"
    ];
    string[] tones = ["tone-blue", "tone-green", "tone-purple", "tone-orange", "tone-pink", "tone-sky"];
    string[] icons = ["▥", "♙", "▣", "▥", "●", "▦"];
    var today = DateTime.Now.ToString("dddd, dd 'tháng' MM, yyyy",
        System.Globalization.CultureInfo.GetCultureInfo("vi-VN"));
}
<section class="page-heading reader-heading">
    <div>
        <h1>@(Model.IsAuthenticated ? $"Chào mừng bạn trở lại, {Model.ReaderName}!" : "Chào mừng bạn đến với thư viện!")</h1>
        <p>Khám phá thế giới tri thức với kho sách của thư viện.</p>
    </div>
    <div class="date-chip">@today</div>
</section>

@if (Model.ApiError is not null)
{
    <div class="alert alert-error">@Model.ApiError</div>
}
@if (Model.OverdueCount > 0)
{
    <div class="alert alert-warning">
        Bạn đang có <b>@Model.OverdueCount</b> phiếu mượn quá hạn.
        <a asp-controller="TaiKhoan" asp-action="LichSuMuon" asp-route-trangThai="dang-muon">Xem ngay →</a>
    </div>
}

<section class="hero-search" id="search">
    <div><h2>Tìm cuốn sách tiếp theo của bạn</h2><p>Tìm theo tên sách, tác giả hoặc ISBN.</p></div>
    <form class="search-box" method="get" asp-controller="Sach" asp-action="Index">
        <span>⌕</span>
        <input id="bookSearch" name="search" placeholder="Tìm kiếm sách, tác giả, ISBN..." aria-label="Tìm kiếm sách" />
        <button type="submit">Tìm kiếm</button>
    </form>
</section>

@if (Model.Categories.Count > 0)
{
    <section class="category-strip" id="categories">
        @for (var i = 0; i < Model.Categories.Count; i++)
        {
            var category = Model.Categories[i];
            <a asp-controller="Sach" asp-action="Index" asp-route-maTheLoai="@category.MaTheLoai" title="@category.TenTheLoai">
                <i class="@tones[i % tones.Length]">@icons[i % icons.Length]</i>@category.TenTheLoai
            </a>
        }
    </section>
}

<div class="reader-grid">
    <div>
        <section class="panel books-panel">
            <div class="panel-title">
                <h2><span class="title-icon tone-blue">★</span>Sách nổi bật</h2>
                <a asp-controller="Sach" asp-action="Index">Xem tất cả →</a>
            </div>
            @if (Model.FeaturedBooks.Count == 0)
            {
                <div class="empty-state">
                    <b>Chưa có sách nào trong thư viện.</b>
                    <small>Quản trị viên cần thêm sách bằng ứng dụng Desktop.</small>
                </div>
            }
            else
            {
                <div class="book-grid">
                    @foreach (var book in Model.FeaturedBooks)
                    {
                        <partial name="_BookCard" model="book" />
                    }
                </div>
            }
        </section>

        @if (Model.SuggestedBooks.Count > 0)
        {
            <section class="panel books-panel">
                <div class="panel-title">
                    <h2><span class="title-icon tone-purple">♙</span>Gợi ý cho bạn</h2>
                    <a asp-controller="Sach" asp-action="Index">Xem tất cả →</a>
                </div>
                <div class="book-grid compact">
                    @foreach (var book in Model.SuggestedBooks)
                    {
                        <partial name="_BookCard" model="book" />
                    }
                </div>
            </section>
        }
    </div>
    <aside class="reader-aside">
        <section class="panel" id="borrowed">
            <div class="panel-title">
                <h2><span class="title-icon dark">▣</span>Sách đang mượn</h2>
                <a asp-controller="TaiKhoan" asp-action="LichSuMuon" asp-route-trangThai="dang-muon">Xem tất cả →</a>
            </div>
            @if (!Model.IsAuthenticated)
            {
                <div class="empty-state">
                    <b>Bạn chưa đăng nhập</b>
                    <small>Đăng nhập để theo dõi sách đang mượn và hạn trả.</small>
                    <a class="empty-cta" asp-controller="TaiKhoan" asp-action="Login">Đăng nhập ngay</a>
                </div>
            }
            else if (Model.CurrentLoans.Count == 0)
            {
                <div class="empty-state">
                    <b>Chưa mượn cuốn sách nào</b>
                    <small>Hãy chọn một cuốn sách từ danh mục để bắt đầu.</small>
                </div>
            }
            else
            {
                @foreach (var loan in Model.CurrentLoans)
                {
                    var cover = covers[Math.Abs(loan.MaPhieu) % covers.Length];
                    var dueText = loan.DaysLeft < 0
                        ? $"Quá hạn {-loan.DaysLeft} ngày"
                        : loan.DaysLeft == 0 ? "Hạn trả: hôm nay" : $"Hạn trả: {loan.HanTra:dd/MM/yyyy}";
                    <a class="loan-item loan-link" asp-controller="TaiKhoan" asp-action="ChiTietMuon" asp-route-id="@loan.MaPhieu">
                        <span class="mini-cover @cover">@loan.Title[..1].ToUpperInvariant()</span>
                        <div>
                            <b>@loan.Title</b>
                            <small>@loan.Subtitle</small>
                            <em class="@(loan.IsOverdue ? "overdue" : string.Empty)">@dueText</em>
                        </div>
                        <strong>›</strong>
                    </a>
                }
            }
        </section>

        <section class="panel" id="notifications">
            <div class="panel-title">
                <h2><span class="title-icon tone-sky">♢</span>Thông báo</h2>
            </div>
            @foreach (var notice in Model.Notices)
            {
                <div class="notice">
                    <i class="@notice.Tone">@notice.Icon</i>
                    <p><b>@notice.Message</b><small>@notice.Detail</small></p>
                </div>
            }
        </section>
    </aside>
</div>

<section class="reader-banner">
    <div>
        <h2>Mỗi cuốn sách là một hành trình mới</h2>
        <p>Đọc sách không chỉ là tiếp thu tri thức, mà còn là cách khám phá thế giới và chính bản thân bạn.</p>
        <a class="banner-cta" asp-controller="Sach" asp-action="Index">Khám phá ngay →</a>
    </div>
    <div class="book-illustration"><span></span><span></span><span></span></div>
</section>
