@{
    ViewData["Title"] = "Trang chủ độc giả";
    ViewData["Role"] = "reader";
}
<section class="page-heading reader-heading">
    <div><h1>Chào mừng bạn trở lại!</h1><p>Khám phá thế giới tri thức với hàng ngàn cuốn sách hấp dẫn.</p></div>
    <div class="date-chip">Thứ sáu, 10 tháng 10, 2026</div>
</section>

<section class="hero-search" id="search">
    <div><h2>Tìm cuốn sách tiếp theo của bạn</h2><p>Tìm theo tên sách, tác giả, ISBN hoặc thể loại.</p></div>
    <form class="search-box" onsubmit="return false"><span>⌕</span><input id="bookSearch" name="bookSearch" placeholder="Tìm kiếm sách, tác giả, thể loại..." aria-label="Tìm kiếm sách" /><button type="submit">Tìm kiếm</button></form>
</section>

<section class="category-strip" id="categories">
    <button><i class="tone-blue">▥</i>Văn học</button><button><i class="tone-green">♙</i>Khoa học</button>
    <button><i class="tone-purple">▣</i>Công nghệ</button><button><i class="tone-orange">▥</i>Kinh tế</button>
    <button><i class="tone-pink">●</i>Thiếu nhi</button><button><i class="tone-sky">▦</i>Sách khác</button>
</section>

